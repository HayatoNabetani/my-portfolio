---
import { profile } from '../data/profile';
import TechLogo from '../components/TechLogo.astro';
import '../styles/global.css';
const projects = [
  { name: 'nhc-tools', type: 'Web tools', description: '時間変換・JSON整形・配列生成など、日々の業務を楽にするWebツール集。', stack: ['Next.js', 'TypeScript', 'Tailwind CSS', 'shadcn/ui', 'FFmpeg.wasm'], image: '/nhc-tools.jpg', imageWidth: 1280, imageHeight: 1134, href: 'https://nhc-tools.vercel.app/', github: 'https://github.com/HayatoNabetani/nhc-tools', linkLabel: 'サイトを見る', kind: 'web' },
  { name: 'My Postico', type: 'macOS app', description: 'フィルタービルダーやSSHトンネル接続を備えた、macOS向けPostgreSQLクライアント。', stack: ['TypeScript', 'React', 'Tauri 2', 'Rust', 'PostgreSQL'], image: '/my-postico-icon.png', imageWidth: 512, imageHeight: 512, href: 'https://github.com/HayatoNabetani/my-postico', github: '', linkLabel: 'GitHubを見る', kind: 'icon' },
  { name: 'My Duet Display', type: 'macOS / iOS · 試作', description: 'Macの画面をブラウザやiPhone・iPadへ配信する試作アプリ。画面拡張は実験機能です。', stack: ['Swift', 'SwiftUI', 'ScreenCaptureKit', 'Network.framework'], image: '/my-duet-display-screenshot.jpg', imageWidth: 1680, imageHeight: 1530, href: '/my-duet-display-screenshot.jpg', github: '', linkLabel: '実画面を見る', kind: 'native' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hayato Nabetaniのポートフォリオ。Web開発・自動化・UI/UXに関心を持つフリーランスエンジニア。" />
    <meta name="theme-color" content="#f8f8f8" />
    <meta property="og:type" content="website" /><meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={`${profile.name} | Portfolio`} />
    <meta property="og:description" content="Web開発と自動化。自分が使いたいものを、ひとつずつ。" />
    <title>{profile.name} | Portfolio</title>
    <link rel="icon" type="image/png" href="/avatar.png" />
    <link rel="apple-touch-icon" href="/avatar.png" />
    <script is:inline>
      try { const saved = localStorage.getItem('portfolio-theme'); if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.dataset.theme = 'dark'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <main id="main" class="container">
      <section id="home" class="intro" aria-labelledby="name">
        <img class="avatar" src="/avatar.png" alt="Hayato Nabetaniのアバター" width="112" height="112" fetchpriority="high" />
        <h1 id="name">{profile.name}<span class="name-coffee" aria-hidden="true">☕</span></h1>
        <p class="role">Freelance Engineer / Web Developer</p>
        <p class="intro-note"><span>Web開発と自動化。</span><span>自分が使いたいものを、ひとつずつ。</span></p>
        <a class="button contact-button" aria-label="Xで連絡する" href={profile.contact} target="_blank" rel="noopener noreferrer"><TechLogo name="X" size={18} /><span>で連絡する</span></a>
      </section>

      <section id="activities" class="section" aria-labelledby="activity-title">
        <h2 class="section-title" id="activity-title"><span>Activities</span></h2>
        <div class="activity-grid">
          <article class="activity-card"><div class="skill-cloud" id="tech-marquee"><div class="skill-track">{[0, 1].map(copy => <div class="skill-set" aria-hidden={copy === 1 ? 'true' : undefined}>{profile.skills.map(skill => <div class="skill-tile"><TechLogo name={skill} size={32} colored /><span>{skill === 'Tailwind CSS' ? 'Tailwind' : skill}</span></div>)}</div>)}</div></div><div class="activity-content"><h3>Tech Stack</h3><p>フロントエンドからバックエンドまで。<br />使いやすさと、日々の作業を楽にする仕組みに関心があります。</p><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHubを見る <span aria-hidden="true">↗</span></a></div></article>
          <article class="activity-card"><div class="activity-symbols" aria-hidden="true"><span><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18m-13 4 3 3-3 3m7-1h3" /></svg></span><span><svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5" /></svg></span><span><svg viewBox="0 0 24 24"><path d="M6 3v11m0 0a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm12-4a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM9 17h4a5 5 0 0 0 5-5v-2" /></svg></span></div><div class="activity-content"><h3>個人開発</h3><p>業務の小さな不便を、つくって解消する。<br />Webツールからデスクトップアプリまで、試しながら開発しています。</p><a class="text-link" href="#works">個人開発一覧へ <span aria-hidden="true">↗</span></a></div></article>
        </div>
      </section>

      <section id="works" class="section" aria-labelledby="works-title">
        <div class="project-overview"><h2 id="works-title">個人開発</h2><p>Webツール・デスクトップアプリ / {projects.length}件</p></div>
        <div class="projects">{projects.map(project => <article class="project-card">
          {project.kind === 'native' ? <button class="project-image native" type="button" data-screenshot={project.image} data-name={project.name} aria-label={`${project.name}の実画面を拡大する`} aria-haspopup="dialog"><img src={project.image} alt={`${project.name}の実際の画面`} width={project.imageWidth} height={project.imageHeight} loading="lazy" /></button> : <a class:list={['project-image', project.kind]} href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.name}のページを開く`}><img src={project.image} alt={project.kind === 'icon' ? 'My Posticoのアプリアイコン' : `${project.name}の実際の画面`} width={project.imageWidth} height={project.imageHeight} loading="lazy" /></a>}
          <div class="project-content"><p class="project-type">{project.type}</p><h3>{project.name}</h3><p>{project.description}</p><div class="project-stack">{project.stack.map(tech => <span><TechLogo name={tech} size={14} />{tech}</span>)}</div><div class="project-links">{project.kind === 'native' ? <button class="text-link screenshot-link" type="button" data-screenshot={project.image} data-name={project.name} aria-haspopup="dialog">実画面を見る <span aria-hidden="true">↗</span></button> : <a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{project.linkLabel} <span aria-hidden="true">↗</span></a>}{project.github && <a class="text-link" href={project.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>}</div></div>
        </article>)}</div>
      </section>

      <section id="about" class="section" aria-labelledby="about-title">
        <h2 class="section-title" id="about-title"><span>About Me</span></h2>
        <dl class="about-list">
          <div class="about-entry"><dt><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 6-6 6 6 6m8-12 6 6-6 6m-5 2 2-16" /></svg><span>興味</span></dt><dd>Webフロントエンド・バックエンド<br />自動化 / UI/UXデザイン</dd></div>
          <div class="about-entry"><dt><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5" /></svg><span>スキル</span></dt><dd class="about-skills">{profile.skills.map(skill => <span><TechLogo name={skill} size={15} />{skill}</span>)}</dd></div>
          <div class="about-entry"><dt><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8Zm12 0h2a3 3 0 0 1 0 6h-2M3 22h15M7 2v2m5-2v2" /></svg><span>好き</span></dt><dd class="about-favorites"><span>コーヒー</span><span>ゲーム</span><span>麻雀</span></dd></div>
          <div class="about-entry"><dt><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 10 3 3-3 3m7 0h3" /></svg><span>好きなAI</span></dt><dd>Codex</dd></div>
        </dl>
      </section>

      <section id="experience" class="section" aria-labelledby="experience-title">
        <h2 class="section-title" id="experience-title"><span>Experience</span></h2>
        <div class="timeline">{profile.experience.map((item,i) => <article class="experience-item"><div class="experience-date"><span>{item.period.replace('PRESENT','現在')}</span>{i === 0 && <span class="current-status"><span aria-hidden="true"></span>現在</span>}</div><div class:list={['experience-icon',{current:i===0}]} aria-hidden="true">{i === 2 ? <svg viewBox="0 0 24 24"><path d="m2 9 10-5 10 5-10 5L2 9Zm4 2v6c4 3 8 3 12 0v-6M22 9v7" /></svg> : i === 1 ? <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4m-5-11 3 3 7-7" /></svg> : <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h1m4 0h1m-6 4h1m4 0h1m-6 4h1m4 0h1m-4 6v-4h2v4" /></svg>}</div><div class="experience-content"><h3 class="experience-company">{item.company}</h3><p class="experience-role">{item.role}{i===0 && <span class="employment-type">業務委託</span>}</p>{item.description && <p class="experience-description">{item.description}</p>}</div></article>)}</div>
      </section>

      <footer><a class="footer-contact" aria-label="Xで連絡する" href={profile.contact} target="_blank" rel="noopener noreferrer"><TechLogo name="X" size={17} /><span>で連絡する</span></a><span>© {new Date().getFullYear()} {profile.name}</span></footer>
    </main>
    <dialog id="screenshot-dialog" class="screenshot-dialog" aria-labelledby="screenshot-title">
      <div class="screenshot-panel"><header><h2 id="screenshot-title">実画面</h2><form method="dialog"><button class="modal-close" aria-label="実画面を閉じる" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button></form></header><div class="screenshot-body"><img id="modal-screenshot" src="/my-duet-display-screenshot.jpg" alt="My Duet Displayの実画面" width="1680" height="1530" /></div></div>
    </dialog>
    <nav class="dock" aria-label="ナビゲーション">
      <a href="#home" aria-label="トップへ" title="Home"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10H3zM9 20v-7h6v7" /></svg></a>
      <a href="#works" aria-label="個人開発へ" title="個人開発"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18m-13 5 2 2-2 2m6 0h3" /></svg></a>
      <span class="dock-divider" aria-hidden="true"></span>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHubを開く" title="GitHub"><TechLogo name="GitHub" size={21} /></a>
      <a href={profile.contact} target="_blank" rel="noopener noreferrer" aria-label="Xを開く" title="X"><TechLogo name="X" size={19} /></a>
      <span class="dock-divider" aria-hidden="true"></span>
      <button id="theme-toggle" aria-label="ダークテーマに切り替える" title="テーマを切り替える"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button>
    </nav>
    <script>
      const dialog = document.querySelector<HTMLDialogElement>('#screenshot-dialog');
      const screenshot = document.querySelector<HTMLImageElement>('#modal-screenshot');
      const screenshotTitle = document.querySelector<HTMLElement>('#screenshot-title');
      document.querySelectorAll<HTMLButtonElement>('[data-screenshot]').forEach(button => button.addEventListener('click', () => {
        if (!dialog || !screenshot || !screenshotTitle || !button.dataset.screenshot) return;
        screenshot.src = button.dataset.screenshot;
        screenshot.alt = `${button.dataset.name}の実画面`;
        screenshotTitle.textContent = `${button.dataset.name} — 実画面`;
        dialog.showModal();
      }));
      dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
      const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const updateLabel = () => { themeButton?.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? 'ライトテーマに切り替える' : 'ダークテーマに切り替える'); };
      updateLabel();
      themeButton?.addEventListener('click', () => { const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = theme; try { localStorage.setItem('portfolio-theme',theme); } catch {} updateLabel(); });
    </script>
  </body>
</html>
